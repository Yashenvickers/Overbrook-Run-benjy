# ─────────────────────────────────────────────────────────────────────────────
# Preee TV — environment configuration
# Every variable here is OPTIONAL for local development. With no env file at
# all, the site runs fully on bundled seed content and forms run in a clearly
# labeled demo mode (validated server-side, nothing persisted).
# Never commit real values. Server-only secrets must NOT be prefixed NEXT_PUBLIC.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical production origin (no trailing slash). Used for metadata, sitemap,
# RSS, JSON-LD and OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sanity CMS ───────────────────────────────────────────────────────────────
# Leave blank to run entirely on data/seed-content.json.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Server-only: a viewer token enables Draft Mode / live preview.
SANITY_API_READ_TOKEN=
# Server-only: secret required to enable draft mode via /api/draft/enable.
SANITY_PREVIEW_SECRET=

# ── Supabase (form submissions + newsletter) ────────────────────────────────
# Server-only. The service-role key is NEVER exposed to the client; all writes
# happen in route handlers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (transactional email) ────────────────────────────────────────────
RESEND_API_KEY=
# Internal notifications go here (e.g. editor@your-domain).
LEADS_NOTIFY_EMAIL=
# Verified sender, e.g. "Preee TV <no-reply@your-domain>".
LEADS_FROM_EMAIL=

# ── Cloudflare Turnstile (bot protection) ───────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Calendar import endpoint ────────────────────────────────────────────────
# Server-only shared secret; required header `x-preee-import-secret` on
# POST /api/calendar/import.
CALENDAR_IMPORT_SECRET=

# ── Analytics (all optional) ────────────────────────────────────────────────
# GA4 measurement id, e.g. G-XXXXXXX. Omit to disable GA entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Vercel Analytics + Speed Insights activate automatically on Vercel deploys.
