{
  "name": "preee-tv",
  "version": "1.0.0",
  "private": true,
  "description": "Preee TV — culture-first digital media platform. Music, culture, and the conversations shaping what comes next.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
