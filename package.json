    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "next": "^15.1.0",
    "next-sanity": "^9.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "resend": "^4.0.0",
    "sanity": "^3.62.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.1.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
